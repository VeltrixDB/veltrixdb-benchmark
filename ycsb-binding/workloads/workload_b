# YCSB Workload B — Read Mostly
# Application: photo tagging — users tag photos, mostly read-back tags
# Mix: 95% reads, 5% updates  |  Distribution: Zipfian
#
# Tests read throughput with cache hit rate under hot-key skew.
# A good VeltrixDB run should show >95% LIRS cache hit rate here.

workload=site.ycsb.workloads.CoreWorkload

recordcount=1000000
operationcount=10000000

fieldcount=1
fieldlength=1000

readallfields=true
readproportion=0.95
updateproportion=0.05
scanproportion=0
insertproportion=0

requestdistribution=zipfian

veltrixdb.host=127.0.0.1
veltrixdb.port=9000
veltrixdb.socket.timeout=10000
veltrixdb.update.mode=overwrite
