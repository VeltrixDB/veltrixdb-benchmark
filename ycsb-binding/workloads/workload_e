# YCSB Workload E — Short Ranges
# Application: threaded conversation — read short sequences of posts by prefix
# Mix: 95% scans, 5% inserts  |  Distribution: Zipfian
#
# Scans map to VeltrixDB NSSCAN (namespace prefix scan with a limit).
# VeltrixDB does not maintain a sorted index, so NSSCAN returns keys in
# insertion order within the namespace — suitable for recent-activity queries.
# Scan result size is controlled by maxscanlength (uniform distribution up to that limit).

workload=site.ycsb.workloads.CoreWorkload

recordcount=1000000
operationcount=1000000

fieldcount=1
fieldlength=200

readallfields=true
readproportion=0
updateproportion=0
scanproportion=0.95
insertproportion=0.05

maxscanlength=100
scanlengthdistribution=uniform

requestdistribution=zipfian

veltrixdb.host=127.0.0.1
veltrixdb.port=9000
veltrixdb.socket.timeout=30000
veltrixdb.update.mode=overwrite
